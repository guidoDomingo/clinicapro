{
  "info": {
    "name": "Clínica - rh_person API",
    "description": "Colección completa para la API CRUD de personas (rh_person) del sistema de clínica",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://clinica_estable.test/api",
      "type": "string"
    },
    {
      "key": "person_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "document_number",
      "value": "12345678",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🧑‍💼 Gestión de Personas",
      "item": [
        {
          "name": "1. Listar Personas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons?page=1&per_page=20&search=&order_column=person_id&order_direction=desc",
              "host": ["{{base_url}}"],
              "path": ["persons"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "per_page",
                  "value": "20",
                  "description": "Registros por página (máx 100)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Término de búsqueda"
                },
                {
                  "key": "order_column",
                  "value": "person_id",
                  "description": "Columna para ordenar"
                },
                {
                  "key": "order_direction",
                  "value": "desc",
                  "description": "Dirección de orden (asc/desc)"
                }
              ]
            },
            "description": "Obtiene una lista paginada de todas las personas activas"
          }
        },
        {
          "name": "2. Obtener Persona por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/show?id={{person_id}}",
              "host": ["{{base_url}}"],
              "path": ["persons", "show"],
              "query": [
                {
                  "key": "id",
                  "value": "{{person_id}}",
                  "description": "ID de la persona"
                }
              ]
            },
            "description": "Obtiene los datos completos de una persona específica por su ID"
          }
        },
        {
          "name": "3. Crear Nueva Persona",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_number\": \"87654321\",\n  \"birth_date\": \"1995-05-20\",\n  \"first_name\": \"María\",\n  \"last_name\": \"González\",\n  \"phone_number\": \"0987654321\",\n  \"gender\": \"F\",\n  \"email\": \"maria.gonzalez@email.com\",\n  \"address\": \"Calle Principal 456\",\n  \"department_id\": 1,\n  \"city_id\": 2,\n  \"business_id\": 1,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons",
              "host": ["{{base_url}}"],
              "path": ["persons"]
            },
            "description": "Crea una nueva persona en el sistema. Los campos requeridos son: document_number, birth_date, first_name, last_name"
          }
        },
        {
          "name": "4. Crear Persona Menor de Edad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_number\": \"11223344\",\n  \"birth_date\": \"2010-03-15\",\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Rodríguez\",\n  \"phone_number\": \"0976543210\",\n  \"gender\": \"F\",\n  \"email\": \"ana.rodriguez@email.com\",\n  \"address\": \"Av. Libertad 789\",\n  \"guardian_name\": \"Carlos Rodríguez\",\n  \"guardian_document\": \"98765432\",\n  \"department_id\": 1,\n  \"city_id\": 1,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons",
              "host": ["{{base_url}}"],
              "path": ["persons"]
            },
            "description": "Ejemplo de creación de una persona menor de edad. Para menores se requieren guardian_name y guardian_document"
          }
        },
        {
          "name": "5. Actualizar Persona",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"0981111111\",\n  \"email\": \"nuevo.email@email.com\",\n  \"address\": \"Nueva dirección 789\",\n  \"department_id\": 2,\n  \"city_id\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons?id={{person_id}}",
              "host": ["{{base_url}}"],
              "path": ["persons"],
              "query": [
                {
                  "key": "id",
                  "value": "{{person_id}}",
                  "description": "ID de la persona a actualizar"
                }
              ]
            },
            "description": "Actualiza los datos de una persona existente. Todos los campos son opcionales."
          }
        },
        {
          "name": "6. Eliminar Persona",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons?id={{person_id}}",
              "host": ["{{base_url}}"],
              "path": ["persons"],
              "query": [
                {
                  "key": "id",
                  "value": "{{person_id}}",
                  "description": "ID de la persona a eliminar"
                }
              ]
            },
            "description": "Elimina físicamente una persona del sistema. También elimina registros relacionados en rh_doctors."
          }
        }
      ]
    },
    {
      "name": "🔍 Búsqueda y Filtros",
      "item": [
        {
          "name": "1. Búsqueda General",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/search?q=Juan",
              "host": ["{{base_url}}"],
              "path": ["persons", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "Juan",
                  "description": "Búsqueda general en nombre, apellido, documento"
                }
              ]
            },
            "description": "Búsqueda general por término en nombre, apellido o documento (método legacy)"
          }
        },
        {
          "name": "2. Búsqueda por Documento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/search?document={{document_number}}",
              "host": ["{{base_url}}"],
              "path": ["persons", "search"],
              "query": [
                {
                  "key": "document",
                  "value": "{{document_number}}",
                  "description": "Búsqueda parcial por número de documento"
                }
              ]
            },
            "description": "Busca personas por número de documento (búsqueda parcial)"
          }
        },
        {
          "name": "3. Búsqueda por Nombre y Género",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/search?name=Juan&gender=M",
              "host": ["{{base_url}}"],
              "path": ["persons", "search"],
              "query": [
                {
                  "key": "name",
                  "value": "Juan",
                  "description": "Búsqueda parcial por nombre"
                },
                {
                  "key": "gender",
                  "value": "M",
                  "description": "Género (M/F/O/U)"
                }
              ]
            },
            "description": "Combina filtros de nombre y género"
          }
        },
        {
          "name": "4. Búsqueda por Apellido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/search?lastname=Pérez",
              "host": ["{{base_url}}"],
              "path": ["persons", "search"],
              "query": [
                {
                  "key": "lastname",
                  "value": "Pérez",
                  "description": "Búsqueda parcial por apellido"
                }
              ]
            },
            "description": "Busca personas por apellido (búsqueda parcial)"
          }
        },
        {
          "name": "5. Búsqueda por Expediente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/search?record=EXP001",
              "host": ["{{base_url}}"],
              "path": ["persons", "search"],
              "query": [
                {
                  "key": "record",
                  "value": "EXP001",
                  "description": "Búsqueda parcial por número de expediente"
                }
              ]
            },
            "description": "Busca personas por número de expediente"
          }
        },
        {
          "name": "6. Obtener Personas Activas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/active",
              "host": ["{{base_url}}"],
              "path": ["persons", "active"]
            },
            "description": "Obtiene solo las personas con estado activo (is_active = true)"
          }
        }
      ]
    },
    {
      "name": "📸 Gestión de Fotos",
      "item": [
        {
          "name": "1. Subir Foto de Perfil",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "profile_photo",
                  "type": "file",
                  "src": "/path/to/your/photo.jpg",
                  "description": "Archivo de imagen (JPG, PNG, GIF - máx 10MB)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/persons/upload-photo?id={{person_id}}",
              "host": ["{{base_url}}"],
              "path": ["persons", "upload-photo"],
              "query": [
                {
                  "key": "id",
                  "value": "{{person_id}}",
                  "description": "ID de la persona"
                }
              ]
            },
            "description": "Sube una foto de perfil para una persona. Formatos permitidos: JPG, PNG, GIF. Tamaño máximo: 10MB"
          }
        }
      ]
    },
    {
      "name": "🏥 Información Profesional",
      "item": [
        {
          "name": "1. Obtener Info Profesional",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/professional?person_id={{person_id}}",
              "host": ["{{base_url}}"],
              "path": ["persons", "professional"],
              "query": [
                {
                  "key": "person_id",
                  "value": "{{person_id}}",
                  "description": "ID de la persona"
                }
              ]
            },
            "description": "Obtiene la información profesional de una persona"
          }
        },
        {
          "name": "2. Guardar Info Profesional - Médico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"person_id\": {{person_id}},\n  \"profesion\": \"Médico\",\n  \"direccion_corporativa\": \"Clínica Central - Consultorio 205\",\n  \"email_profesional\": \"doctor@clinica.com\",\n  \"denominacion_corporativa\": \"Dr. Juan Pérez - Cardiólogo\",\n  \"ruc\": \"12345678-9\",\n  \"whatsapp\": \"0981234567\",\n  \"plan\": \"Premium\",\n  \"business_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons/professional",
              "host": ["{{base_url}}"],
              "path": ["persons", "professional"]
            },
            "description": "Guarda información profesional de un médico. Automáticamente crea/actualiza registro en rh_doctors"
          }
        },
        {
          "name": "3. Guardar Info Profesional - Otro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"person_id\": {{person_id}},\n  \"profesion\": \"Enfermero/a\",\n  \"direccion_corporativa\": \"Hospital Regional - Área de Emergencias\",\n  \"email_profesional\": \"enfermero@hospital.com\",\n  \"denominacion_corporativa\": \"Lic. María González - Enfermera\",\n  \"ruc\": \"98765432-1\",\n  \"whatsapp\": \"0987654321\",\n  \"plan\": \"Básico\",\n  \"business_id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons/professional",
              "host": ["{{base_url}}"],
              "path": ["persons", "professional"]
            },
            "description": "Guarda información profesional de una persona que no es médico"
          }
        }
      ]
    },
    {
      "name": "🔗 Alias y Compatibilidad",
      "item": [
        {
          "name": "1. Listar Personas (Alias: people)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/people?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["people"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Alias de /persons para compatibilidad"
          }
        }
      ]
    },
    {
      "name": "⚠️ Casos de Error",
      "item": [
        {
          "name": "1. Error - Persona No Encontrada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/persons/show?id=99999",
              "host": ["{{base_url}}"],
              "path": ["persons", "show"],
              "query": [
                {
                  "key": "id",
                  "value": "99999",
                  "description": "ID inexistente"
                }
              ]
            },
            "description": "Prueba de error 404 - Persona no encontrada"
          }
        },
        {
          "name": "2. Error - Documento Duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_number\": \"12345678\",\n  \"birth_date\": \"1990-01-15\",\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Pérez\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons",
              "host": ["{{base_url}}"],
              "path": ["persons"]
            },
            "description": "Prueba de error 409 - Documento duplicado"
          }
        },
        {
          "name": "3. Error - Campos Requeridos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Juan\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons",
              "host": ["{{base_url}}"],
              "path": ["persons"]
            },
            "description": "Prueba de error 400 - Campos requeridos faltantes"
          }
        },
        {
          "name": "4. Error - Email Inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_number\": \"11111111\",\n  \"birth_date\": \"1990-01-15\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"email\": \"email-invalido\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons",
              "host": ["{{base_url}}"],
              "path": ["persons"]
            },
            "description": "Prueba de error 400 - Formato de email inválido"
          }
        },
        {
          "name": "5. Error - Menor sin Tutor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_number\": \"22222222\",\n  \"birth_date\": \"2010-01-15\",\n  \"first_name\": \"Menor\",\n  \"last_name\": \"Sin Tutor\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/persons",
              "host": ["{{base_url}}"],
              "path": ["persons"]
            },
            "description": "Prueba de error 400 - Menor de edad sin información del tutor"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Script que se ejecuta antes de cada request",
          "// Puedes agregar lógica de autenticación aquí si es necesaria"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Script que se ejecuta después de cada response",
          "// Tests automáticos básicos",
          "pm.test(\"Status code is not 500\", function () {",
          "    pm.expect(pm.response.code).to.not.equal(500);",
          "});",
          "",
          "pm.test(\"Response has status field\", function () {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('status');",
          "});"
        ]
      }
    }
  ]
}