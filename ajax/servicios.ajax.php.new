<?php
/**
 * Archivo para procesar peticiones AJAX relacionadas con servicios médicos
 * 
 * Este controlador AJAX gestiona todas las operaciones asíncronas relacionadas
 * con servicios médicos, incluyendo reservas, horarios de médicos y operaciones
 * de gestión de citas.
 * 
 * @author Sistema Clínico
 * @version 2.1
 */

// Aseguramos que todas las rutas sean relativas al directorio raíz
$rutaBase = dirname(__FILE__, 2); // Obtiene la ruta del directorio raíz (dos niveles arriba)
require_once $rutaBase . "/controller/servicios.controller.php";
require_once $rutaBase . "/model/servicios.model.php";

// Configurar cabeceras para JSON
header('Content-Type: application/json');
header('Cache-Control: no-cache, must-revalidate');
header('Expires: 0');
date_default_timezone_set('America/Caracas');

// Iniciar sesión si no está iniciada
if (!isset($_SESSION)) {
    session_start();
}

// Archivo de log principal para servicios
$logFile = $rutaBase . '/logs/servicios_ajax.log';

/**
 * Función para registrar mensajes en el archivo de log
 * 
 * @param string $mensaje Mensaje a registrar
 * @param string $tipo Tipo de mensaje (INFO, ERROR, DEBUG)
 * @param string $archivo Archivo de log específico (opcional)
 */
function logServicio($mensaje, $tipo = 'INFO', $archivo = null) {
    global $logFile;
    $archivo = $archivo ?: $logFile;
    $fecha = date('Y-m-d H:i:s');
    $mensaje = "[$fecha][$tipo] $mensaje";
    error_log($mensaje . PHP_EOL, 3, $archivo);
}

// Registrar inicio de la petición
if (isset($_POST['action'])) {
    logServicio("Nueva petición AJAX recibida: " . $_POST['action']);
}

// Procesar la acción solicitada
if (isset($_POST['action'])) {
    $action = $_POST['action'];
    
    switch ($action) {
        /**
         * Obtiene las categorías de servicios médicos
         */
        case 'obtenerCategorias':
            try {
                $categorias = ControladorServicios::ctrObtenerCategorias();
                echo json_encode([
                    "status" => "success",
                    "data" => $categorias
                ]);
                logServicio("Categorías obtenidas: " . count($categorias));
            } catch (Exception $e) {
                logServicio("Error al obtener categorías: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener categorías: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene los servicios médicos, opcionalmente filtrados por categoría
         */
        case 'obtenerServicios':
            try {
                $categoriaId = isset($_POST['categoria_id']) ? $_POST['categoria_id'] : null;
                $servicios = ControladorServicios::ctrObtenerServicios($categoriaId);
                echo json_encode([
                    "status" => "success",
                    "data" => $servicios
                ]);
                logServicio("Servicios obtenidos: " . count($servicios) . 
                           ($categoriaId ? " para categoría ID=$categoriaId" : ""));
            } catch (Exception $e) {
                logServicio("Error al obtener servicios: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener servicios: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene los detalles de un servicio específico por ID
         */
        case 'obtenerServicioPorId':
            try {
                if (isset($_POST['servicio_id'])) {
                    $servicioId = $_POST['servicio_id'];
                    $datos = ControladorServicios::ctrObtenerServicioPorId($servicioId);
                    echo json_encode([
                        "status" => "success",
                        "data" => $datos
                    ]);
                    logServicio("Servicio obtenido por ID: $servicioId");
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "ID de servicio no proporcionado"
                    ]);
                    logServicio("Error: ID de servicio no proporcionado", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al obtener servicio por ID: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener servicio: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene los horarios disponibles para un médico
         */
        case 'obtenerHorariosMedico':
            try {
                if (isset($_POST['doctor_id'])) {
                    $doctorId = $_POST['doctor_id'];
                    $horarios = ControladorServicios::ctrObtenerHorariosMedico($doctorId);
                    echo json_encode([
                        "status" => "success",
                        "data" => $horarios
                    ]);
                    logServicio("Horarios obtenidos para médico ID: $doctorId. Total: " . count($horarios));
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "ID de doctor no proporcionado"
                    ]);
                    logServicio("Error: ID de doctor no proporcionado", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al obtener horarios de médico: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener horarios: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Genera slots de tiempo disponibles para reservas
         */
        case 'generarSlotsDisponibles':
            try {
                if (isset($_POST['servicio_id']) && isset($_POST['doctor_id']) && isset($_POST['fecha'])) {
                    $servicioId = $_POST['servicio_id'];
                    $doctorId = $_POST['doctor_id'];
                    $fecha = $_POST['fecha'];

                    logServicio("Generando slots disponibles: ServicioID=$servicioId, DoctorID=$doctorId, Fecha=$fecha");
                    
                    $slots = ControladorServicios::ctrGenerarSlotsDisponibles($servicioId, $doctorId, $fecha);
                    echo json_encode([
                        "status" => "success",
                        "data" => $slots
                    ]);
                    logServicio("Slots generados: " . count($slots));
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "Faltan parámetros requeridos"
                    ]);
                    logServicio("Error: Faltan parámetros para generar slots", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al generar slots disponibles: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al generar slots: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene médicos disponibles para una fecha específica
         */
        case 'obtenerMedicosPorFecha':
            try {
                if (isset($_POST['fecha'])) {
                    $fecha = $_POST['fecha'];
                    $medicos = ControladorServicios::ctrObtenerMedicosDisponiblesPorFecha($fecha);
                    echo json_encode([
                        "status" => "success",
                        "data" => $medicos
                    ]);
                    logServicio("Médicos disponibles para fecha $fecha: " . count($medicos));
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "Fecha no proporcionada"
                    ]);
                    logServicio("Error: Fecha no proporcionada para obtener médicos", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al obtener médicos por fecha: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener médicos: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene servicios disponibles para un médico en una fecha
         */
        case 'obtenerServiciosPorFechaMedico':
            try {
                if (isset($_POST['fecha']) && isset($_POST['doctor_id'])) {
                    $fecha = $_POST['fecha'];
                    $doctorId = $_POST['doctor_id'];
                    $servicios = ControladorServicios::ctrObtenerServiciosPorFechaMedico($fecha, $doctorId);
                    echo json_encode([
                        "status" => "success",
                        "data" => $servicios
                    ]);
                    logServicio("Servicios para fecha $fecha y médico ID $doctorId: " . count($servicios));
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "Faltan parámetros requeridos"
                    ]);
                    logServicio("Error: Faltan parámetros para obtener servicios por fecha/médico", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al obtener servicios por fecha/médico: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener servicios: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene reservas filtradas por fecha, médico y estado
         */
        case 'obtenerReservas':
            try {
                $fecha = isset($_POST['fecha']) ? $_POST['fecha'] : date('Y-m-d');
                $doctorId = isset($_POST['doctor_id']) ? intval($_POST['doctor_id']) : null;
                $estado = isset($_POST['estado']) ? $_POST['estado'] : null;
                
                logServicio("Obteniendo reservas: Fecha=$fecha, DoctorID=" . ($doctorId ?? "null") . ", Estado=" . ($estado ?? "null"));
                
                $reservas = ControladorServicios::ctrObtenerReservasPorFecha($fecha, $doctorId, $estado);
                
                logServicio("Reservas encontradas: " . count($reservas));
                
                echo json_encode([
                    "status" => "success",
                    "data" => $reservas
                ]);
            } catch (Exception $e) {
                logServicio("Error al obtener reservas: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener reservas: " . $e->getMessage(),
                    "data" => []
                ]);
            }
            break;
            
        /**
         * Crea una nueva reserva con los datos proporcionados
         */
        case 'crearReserva':
            try {
                // Recopilar datos desde la petición POST
                $datos = [
                    'servicio_id' => $_POST['servicio_id'] ?? null,
                    'doctor_id' => $_POST['doctor_id'] ?? null,
                    'paciente_id' => $_POST['persona_id'] ?? null,
                    'fecha_reserva' => $_POST['fecha_reserva'] ?? null,
                    'hora_inicio' => $_POST['hora_inicio'] ?? null,
                    'hora_fin' => $_POST['hora_fin'] ?? null
                ];
                
                // Datos opcionales
                if (isset($_POST['agenda_id'])) $datos['agenda_id'] = $_POST['agenda_id'];
                if (isset($_POST['observaciones'])) $datos['observaciones'] = $_POST['observaciones'];
                if (isset($_POST['sala_id'])) $datos['sala_id'] = $_POST['sala_id'];
                if (isset($_POST['tarifa_id'])) $datos['tarifa_id'] = $_POST['tarifa_id'];
                if (isset($_POST['precio_final'])) $datos['precio_final'] = $_POST['precio_final'];
                
                // Datos de usuario
                if (isset($_SESSION['user_id'])) {
                    $datos['created_by'] = $_SESSION['user_id'];
                }
                if (isset($_SESSION['business_id'])) {
                    $datos['business_id'] = $_SESSION['business_id'];
                }
                
                logServicio("Creando reserva: " . json_encode($datos));
                
                $resultado = ControladorServicios::ctrCrearReserva($datos);
                echo json_encode($resultado);
                
                if (isset($resultado['status']) && $resultado['status'] == 'success') {
                    logServicio("Reserva creada con éxito: ID " . ($resultado['reserva_id'] ?? 'desconocido'));
                } else {
                    logServicio("Error al crear reserva: " . json_encode($resultado), "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Excepción al crear reserva: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al crear reserva: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Cambia el estado de una reserva existente
         */
        case 'cambiarEstadoReserva':
            try {
                if (isset($_POST['reserva_id']) && isset($_POST['nuevo_estado'])) {
                    $reservaId = $_POST['reserva_id'];
                    $estado = $_POST['nuevo_estado'];
                    
                    logServicio("Cambiando estado de reserva ID $reservaId a: $estado");
                    
                    $resultado = ControladorServicios::ctrCambiarEstadoReserva($reservaId, $estado);
                    
                    // Adaptar la respuesta al formato esperado por el cliente
                    echo json_encode([
                        "status" => $resultado["error"] ? "error" : "success",
                        "mensaje" => $resultado["mensaje"]
                    ]);
                    
                    if (!$resultado["error"]) {
                        logServicio("Estado de reserva ID $reservaId cambiado con éxito a: $estado");
                    } else {
                        logServicio("Error al cambiar estado de reserva ID $reservaId: " . $resultado["mensaje"], "ERROR");
                    }
                } else {
                    echo json_encode([
                        "status" => "error",
                        "mensaje" => "Faltan parámetros requeridos"
                    ]);
                    logServicio("Error: Faltan parámetros para cambiar estado de reserva", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Excepción al cambiar estado de reserva: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "mensaje" => "Error al cambiar estado: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Busca pacientes por término de búsqueda
         */
        case 'buscarPaciente':
            try {
                if (isset($_POST['termino'])) {
                    $termino = $_POST['termino'];
                    $pacientes = ControladorServicios::ctrBuscarPaciente($termino);
                    
                    logServicio("Búsqueda de paciente: '$termino' - Resultados: " . count($pacientes));
                    
                    echo json_encode([
                        "status" => "success",
                        "data" => $pacientes
                    ]);
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "Término de búsqueda no proporcionado"
                    ]);
                    logServicio("Error: Término de búsqueda no proporcionado", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al buscar paciente: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al buscar paciente: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Busca paciente por ID específico
         */
        case 'buscarPacientePorId':
            try {
                if (isset($_POST['paciente_id'])) {
                    $pacienteId = $_POST['paciente_id'];
                    $paciente = ControladorServicios::ctrBuscarPacientePorId($pacienteId);
                    
                    logServicio("Búsqueda de paciente por ID: $pacienteId - Resultados: " . count($paciente));
                    
                    echo json_encode([
                        "status" => "success",
                        "data" => $paciente
                    ]);
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "ID de paciente no proporcionado"
                    ]);
                    logServicio("Error: ID de paciente no proporcionado", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al buscar paciente por ID: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al buscar paciente: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Guarda una reserva completa con todos sus datos
         */
        case 'guardarReserva':
            try {
                if (isset($_POST['doctor_id']) && isset($_POST['servicio_id']) && isset($_POST['paciente_id']) && 
                    isset($_POST['fecha_reserva']) && isset($_POST['hora_inicio']) && isset($_POST['hora_fin'])) {
                    
                    // Capturar datos de la reserva
                    $datos = [
                        'doctor_id' => intval($_POST['doctor_id']),
                        'servicio_id' => intval($_POST['servicio_id']),
                        'paciente_id' => intval($_POST['paciente_id']),
                        'fecha_reserva' => $_POST['fecha_reserva'],
                        'hora_inicio' => $_POST['hora_inicio'],
                        'hora_fin' => $_POST['hora_fin'],
                        'seguro_id' => $_POST['seguro_id'] ?? null,
                        'observaciones' => isset($_POST['observaciones']) ? $_POST['observaciones'] : ''
                    ];
                    
                    // Agregar campos opcionales
                    if (isset($_POST['agenda_id']) && !empty($_POST['agenda_id'])) {
                        $datos['agenda_id'] = intval($_POST['agenda_id']);
                    }
                    
                    if (isset($_POST['tarifa_id']) && !empty($_POST['tarifa_id'])) {
                        $datos['tarifa_id'] = intval($_POST['tarifa_id']);
                    }
                    
                    if (isset($_POST['sala_id']) && !empty($_POST['sala_id'])) {
                        $datos['sala_id'] = intval($_POST['sala_id']);
                    }
                    
                    // Registrar intento de guardar reserva
                    logServicio("Guardando reserva con datos: " . json_encode($datos));
                    
                    // Guardar la reserva
                    $resultado = ControladorServicios::ctrGuardarReserva($datos);
                    
                    if ($resultado) {
                        echo json_encode([
                            "status" => "success",
                            "message" => "Reserva guardada exitosamente",
                            "reserva_id" => $resultado
                        ]);
                        logServicio("Reserva guardada con éxito, ID: $resultado");
                    } else {
                        echo json_encode([
                            "status" => "error",
                            "message" => "No se pudo guardar la reserva. Verifique que no haya conflictos de horarios."
                        ]);
                        logServicio("Error al guardar reserva: No se pudo crear", "ERROR");
                    }
                } else {
                    $camposFaltantes = [];
                    $camposRequeridos = ['doctor_id', 'servicio_id', 'paciente_id', 'fecha_reserva', 'hora_inicio', 'hora_fin'];
                    
                    foreach ($camposRequeridos as $campo) {
                        if (!isset($_POST[$campo]) || empty($_POST[$campo])) {
                            $camposFaltantes[] = $campo;
                        }
                    }
                    
                    $mensaje = "Faltan datos requeridos para guardar la reserva: " . implode(", ", $camposFaltantes);
                    logServicio($mensaje, "ERROR");
                    
                    echo json_encode([
                        "status" => "error",
                        "message" => $mensaje,
                        "campos_faltantes" => $camposFaltantes
                    ]);
                }
            } catch (Exception $e) {
                logServicio("Excepción al guardar reserva: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al guardar la reserva: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene los proveedores de seguro médico
         */
        case 'obtenerProveedoresSeguro':
            try {
                $proveedores = ControladorServicios::ctrObtenerProveedoresSeguro();
                echo json_encode([
                    "status" => "success",
                    "data" => $proveedores
                ]);
                logServicio("Proveedores de seguro obtenidos: " . count($proveedores));
            } catch (Exception $e) {
                logServicio("Error al obtener proveedores de seguro: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener proveedores de seguro: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Busca reservas con filtros avanzados
         */
        case 'buscarReservas':
            try {
                // Procesar todos los parámetros de filtro
                $fecha = isset($_POST['fecha']) && !empty($_POST['fecha']) ? $_POST['fecha'] : date('Y-m-d');
                
                // Asegurar que doctorId sea tratado correctamente como entero o null
                $doctorId = null;
                if (isset($_POST['doctor_id']) && $_POST['doctor_id'] !== '0' && $_POST['doctor_id'] !== '') {
                    $doctorId = intval($_POST['doctor_id']);
                }
                
                // Procesar filtro de estado
                $estado = null;
                if (isset($_POST['estado']) && $_POST['estado'] !== '0' && $_POST['estado'] !== '') {
                    $estado = trim($_POST['estado']);
                }
                
                // Procesar filtro de paciente
                $paciente = null;
                if (isset($_POST['paciente']) && !empty($_POST['paciente'])) {
                    $paciente = trim($_POST['paciente']);
                }
                
                logServicio("Buscando reservas con filtros: Fecha=$fecha, DoctorID=" . 
                           ($doctorId ?? "null") . ", Estado=" . ($estado ?? "null") . 
                           ", Paciente=" . ($paciente ?? "null"));
                
                // Obtener reservas según los filtros
                $reservas = ControladorServicios::ctrBuscarReservas($fecha, $doctorId, $estado, $paciente);
                
                logServicio("Reservas encontradas: " . count($reservas));
                
                // Enviar respuesta con información de filtros para depuración
                echo json_encode([
                    "status" => "success",
                    "data" => $reservas,
                    "filtros" => [
                        "fecha" => $fecha,
                        "doctor_id" => $doctorId,
                        "estado" => $estado,
                        "paciente" => $paciente
                    ]
                ]);
            } catch (Exception $e) {
                logServicio("Error al buscar reservas: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "mensaje" => "Error al buscar reservas: " . $e->getMessage(),
                    "debug_info" => [
                        "fecha" => $fecha ?? date('Y-m-d'),
                        "doctor_id" => $doctorId ?? null,
                        "estado" => $estado ?? null,
                        "paciente" => $paciente ?? null
                    ]
                ]);
            }
            break;
            
        /**
         * Obtiene la lista de médicos disponibles
         */
        case 'obtenerMedicos':
            try {
                $medicos = ControladorServicios::ctrObtenerMedicos();
                
                echo json_encode([
                    "status" => "success",
                    "data" => $medicos
                ]);
                
                logServicio("Médicos obtenidos: " . count($medicos));
            } catch (Exception $e) {
                logServicio("Error al obtener médicos: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "mensaje" => "Error al obtener médicos: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene los horarios disponibles para una fecha y médico específicos
         */
        case 'obtenerHorariosDisponibles':
            try {
                if (isset($_POST['doctor_id']) && isset($_POST['fecha'])) {
                    // El servicio_id ahora es opcional
                    $servicioId = isset($_POST['servicio_id']) ? $_POST['servicio_id'] : 0;
                    $doctorId = $_POST['doctor_id'];
                    $fecha = $_POST['fecha'];
                    
                    logServicio("Obteniendo horarios disponibles: ServicioID=$servicioId, DoctorID=$doctorId, Fecha=$fecha");
                    
                    // Llamar al método del controlador
                    $horarios = ControladorServicios::ctrObtenerHorariosDisponibles($servicioId, $doctorId, $fecha);
                    
                    // Si no hay horarios para el servicio específico, intentar obtener cualquier horario del doctor
                    if (empty($horarios) && $servicioId > 0) {
                        logServicio("No se encontraron horarios para el servicio específico. Buscando cualquier horario del doctor.");
                        $horarios = ControladorServicios::ctrObtenerHorariosDisponibles(0, $doctorId, $fecha);
                    }
                    
                    logServicio("Horarios disponibles encontrados: " . count($horarios));
                    
                    echo json_encode([
                        "status" => "success",
                        "data" => $horarios
                    ]);
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "Faltan parámetros requeridos: doctor_id y fecha son obligatorios"
                    ]);
                    logServicio("Error: Faltan parámetros para obtener horarios disponibles", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al obtener horarios disponibles: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener horarios disponibles: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Obtiene los detalles de una reserva específica
         */
        case 'obtenerDetallesReserva':
            try {
                if (isset($_POST['reserva_id'])) {
                    $reserva_id = $_POST['reserva_id'];
                    
                    logServicio("Obteniendo detalles de reserva ID: $reserva_id");
                    
                    // Incluir el modelo de reservas si no está incluido ya
                    if (!class_exists('ReservasModel')) {
                        require_once $rutaBase . "/model/reservas.model.php";
                    }
                    
                    $modelo = new ReservasModel();
                    $detalles = $modelo->obtenerReservaPorId($reserva_id);
                    
                    if ($detalles) {
                        echo json_encode([
                            "status" => "success",
                            "data" => $detalles
                        ]);
                        logServicio("Detalles de reserva ID $reserva_id obtenidos con éxito");
                    } else {
                        echo json_encode([
                            "status" => "error",
                            "message" => "No se encontró la reserva con ID: " . $reserva_id
                        ]);
                        logServicio("Error: No se encontró la reserva con ID: $reserva_id", "ERROR");
                    }
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "No se proporcionó ID de reserva"
                    ]);
                    logServicio("Error: No se proporcionó ID de reserva", "ERROR");
                }
            } catch (Exception $e) {
                logServicio("Error al obtener detalles de reserva: " . $e->getMessage(), "ERROR");
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al obtener detalles de la reserva: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Envía un mensaje por WhatsApp
         */
        case 'enviarWhatsApp':
            try {
                if (isset($_POST['telefono']) && isset($_POST['mensaje'])) {
                    $telefono = $_POST['telefono'];
                    $mensaje = $_POST['mensaje'];
                    
                    // Registrar datos antes de procesar
                    logServicio("Enviando WhatsApp a teléfono {$telefono}, mensaje: " . substr($mensaje, 0, 50) . "...", "INFO", $rutaBase . '/logs/whatsapp.log');
                    
                    $resultado = ControladorServicios::ctrEnviarWhatsApp($telefono, $mensaje);
                    echo json_encode($resultado);
                    
                    if ($resultado["status"] === "success") {
                        logServicio("WhatsApp enviado con éxito a {$telefono}", "INFO", $rutaBase . '/logs/whatsapp.log');
                    } else {
                        logServicio("Error al enviar WhatsApp: " . ($resultado["message"] ?? "Error desconocido"), "ERROR", $rutaBase . '/logs/whatsapp.log');
                    }
                } else {
                    echo json_encode([
                        "status" => "error",
                        "message" => "Faltan parámetros: teléfono y mensaje son obligatorios"
                    ]);
                    logServicio("Error: Faltan parámetros para enviar WhatsApp", "ERROR", $rutaBase . '/logs/whatsapp.log');
                }
            } catch (Exception $e) {
                logServicio("Excepción al enviar WhatsApp: " . $e->getMessage(), "ERROR", $rutaBase . '/logs/whatsapp.log');
                echo json_encode([
                    "status" => "error",
                    "message" => "Error al enviar mensaje: " . $e->getMessage()
                ]);
            }
            break;
            
        /**
         * Acción no reconocida
         */
        default:
            logServicio("Acción no reconocida: " . $action, "ERROR");
            echo json_encode([
                "status" => "error",
                "message" => "Acción no reconocida: " . $action
            ]);
            break;
    }
} else {
    logServicio("Petición sin acción especificada", "ERROR");
    echo json_encode([
        "status" => "error",
        "message" => "No se especificó una acción"
    ]);
}
