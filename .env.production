# Configuración de Entorno - Sistema Clínica (PRODUCCIÓN)
# =======================================================

# Entorno de la aplicación
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio-produccion.com

# Configuración de Base de Datos - PRODUCCIÓN
DB_DRIVER=pgsql
DB_HOST=181.122.125.143
DB_PORT=5454
DB_DATABASE=clinica
DB_USERNAME=acmeuser
DB_PASSWORD=wjstks

# Configuración de Logs - PRODUCCIÓN
LOG_PATH=/var/log/clinica/
LOG_LEVEL=info

# Configuración de Archivos - PRODUCCIÓN
UPLOAD_PATH=/var/www/clinica/uploads/
TEMP_PATH=/tmp/clinica/

# Configuración de Email (opcional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sistema Clínica"

# Configuración de Sesión
SESSION_LIFETIME=120
SESSION_DRIVER=file

# Configuración de API
API_RATE_LIMIT=100
API_CACHE_TTL=3600

# Timezone y versión
APP_TIMEZONE=America/Asuncion
API_VERSION=1.0.0