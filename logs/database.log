                coalesce(p.first_name, '') || ' ' || coalesce(p.last_name, '') as nombre_doctor,
                ad.dia_semana,
                ad.hora_inicio,
                ad.hora_fin,
                ad.intervalo_minutos,
                ad.cupo_maximo
            FROM
                agendas_detalle ad
