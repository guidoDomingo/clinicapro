# Configuración para el módulo de API de correo
# Permite acceso a archivos PHP y configura headers CORS

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Permitir acceso a archivos PHP
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Headers CORS para APIs
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
    Header always set Content-Type "application/json; charset=UTF-8"
</IfModule>

# Configuración PHP para APIs
<IfModule mod_php7.c>
    php_value error_reporting "E_ALL"
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Permitir archivos PHP específicos
<Files "mail_config.php">
    Require all granted
</Files>

<Files "debug_mail.php">
    Require all granted
</Files>

<Files "send_pdf.php">
    Require all granted
</Files>